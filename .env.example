# Generate machine-specific values with: bash scripts/setup.sh
HITL_UID=1000
HITL_GID=1000
DOCKER_GID=999
DOCKER_SOCKET=/var/run/docker.sock
# Must be an existing absolute host path, mounted at the same path in the container.
HITL_DATA_DIR=/absolute/path/to/human-in-the-loop-infra/.hitl
HITL_PORT=8765
# Optional; leave empty to use the Codex default model.
HITL_CODEX_MODEL=
